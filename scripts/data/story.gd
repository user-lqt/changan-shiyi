	"night_canal": {"tag": "见闻", "title": "永安渠", "tex": "",
		"text": "隋代开凿的人工渠，自城南引交水入城，穿过西市一带向北注入渭水，供城中用水与漕运。",
		"more": "唐长安城内有龙首渠、清明渠、永安渠等多条水渠，渠边柳树成行。"},
	"night_zhuque": {"tag": "见闻", "title": "朱雀大街", "tex": "",
		"text": "长安城的中轴线，北起皇城朱雀门，南至明德门，宽约一百五十米，把全城分成东西两半。",
		"more": "街东五十四坊属万年县，街西五十四坊属长安县。"},
	"night_jinwu": {"tag": "见闻", "title": "街鼓与宵禁", "tex": "",
		"text": "唐代以街鼓与坊门管理夜间通行，闭门鼓后、开门鼓前，无故在坊外街道行走称为「犯夜」。",
		"more": "《唐律疏议》规定犯夜笞二十，也列有公事、疾病等例外；疏文明确坊内行走不拘此律。节日放夜另有安排。"},
	"camel": {"tag": "见闻", "title": "三彩马与骆驼", "tex": "",
		"text": "唐三彩是低温铅釉陶器，常见黄、绿、白等釉色，「三彩」不限定恰好三种颜色。马、骆驼等俑多见于墓葬随葬。",
		"more": "马俑与骆驼俑陈列在铺中，釉色交融，造型生动。"},
	"stele": {"tag": "塔铭", "title": "顶层石碑", "tex": "",
		"text": "碑上刻着几行小字：\n「塔顶三铃，以月为序：先朔，次弦，后望。」",
		"more": "朔时月面大体背光；弦月呈半圆；望时月面近乎全亮。上弦常在初七、初八附近，望常在十五、十六附近。这是机关的排序线索。"},
	"window": {"tag": "见闻", "title": "塔窗望长安", "tex": "",
		"text": "从塔顶望去，长安一百零八坊整齐排列，如棋盘一般。白居易诗云：「百千家似围棋局，十二街如种菜畦。」",
		"more": "诗句出自《登观音台望城》，以围棋和菜畦比喻街坊秩序，并非大雁塔窗景的现场记录。"},
	"coin": {"tag": "见闻", "title": "开元通宝", "tex": "",
		"text": "一枚铜钱。「开元通宝」始铸于唐高祖武德四年（621 年），确立了「十钱为一两」的制度。",
		"more": "不是碎片。不过温师傅说可以留着。"},
	"cat": {"tag": "见闻", "title": "一双眼睛", "tex": "",
		"text": "两点幽光一闪——一只狸猫从柜下窜了出去。",
		"more": "不是碎片。它大概也被怪光吓到了。"},
}

