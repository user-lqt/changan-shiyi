extends "res://scripts/core/canvas.gd"
## 第三章 · 胡旋: the Sogdian tavern behind the West Market.
## Part A (调查): ask around for the boy who sold the shard; the dancer 米娜 says he owes the
##   house a debt and is hiding upstairs. She will only call him down if Su beats the jiegu
##   drum for her 胡旋舞.
## Part B (击鼓): a rhythm game in the three sections of a Tang 大曲 (散序 · 中序 · 入破).
##   Notes slide along a lane toward the drum. F / J (or left click) = 咚 centre,
##   D / K (or right click) = 嗒 rim, a roll (连打) takes any drum key repeatedly.
##   Judgement: 良 ±45 ms, 可 ±100 ms, else 不可. The dancer spins faster with the combo.
## Passing needs 70 % accuracy (60 % in easy mode); the chart is generated by tools/build_huxuan.py.

const Story = preload("res://scripts/data/story.gd")
const Chart = preload("res://scripts/data/huxuan_chart.gd")
const Visuals = preload("res://scripts/data/huxuan_visuals.gd")
const GREAT := 0.045
const GOOD := 0.10
const LEAD := 2.0                     # seconds a note is visible before it reaches the drum
const LANE := Rect2(70, 708, 1300, 108)
const HIT_X := 210.0
const PASS := 0.70
const PASS_EASY := 0.60
const SPOTS := {
	"barkeep": {"p": Vector2(984, 446), "label": "酒家胡", "r": Rect2(914, 439, 140, 313)},
	"jar": {"p": Vector2(330, 560), "label": "葡萄酒瓮", "r": Rect2(270, 500, 130, 110)},
	"drum": {"p": Vector2(914, 405), "label": "羯鼓", "r": Rect2(859, 358, 104, 138)},
	"stairs": {"p": Vector2(640, 300), "label": "楼梯 · 楼上帘后", "r": Rect2(570, 240, 150, 120)},
}
const MI_FOOT := Vector2(560, 772)

var phase := "explore"                # explore | ready | play | result | done
var asked := {}
var easy := false
var notes: Array = []                 # active chart: copies of Chart.NOTES with state
var song_t := -LEAD                   # song clock (negative = count-in)
var start_ms := 0
var result := {}
var combo := 0
var best_combo := 0
var score := 0
var counts := {"great": 0, "good": 0, "miss": 0}
var roll_hits := 0
var judge_text := ""
var judge_t := 0.0
var judge_col := Color.WHITE
var drum_flash := {"don": 0.0, "ka": 0.0}
var spin := 0.0                       # dancer spin angle
var spin_speed := 0.0
var sleeves: Array[Vector3] = []      # trailing ribbon points
var section_banner := 0.0
var last_section := -1
var player: AudioStreamPlayer
var test_clock := -INF                # captures pin the clock here; -INF = use the real clock
var autoplay := false
var auto_used := false
var end_t := 0.0
var section_mix := 0.0


func enter() -> void:
	g.music("ambient")
	g.say("ch3_arrive")


func chrome() -> bool:
	return phase != "play"


func staged() -> bool:
	return phase in ["explore", "ready", "done"]


func help_lines() -> Array:
	if phase in ["ready", "play"]:
		return ["鼓点从右往左滑向羯鼓。到达金色圆圈时敲击。",
			"红色「咚」：F / J 或鼠标左键。蓝色「嗒」：D / K 或鼠标右键。",
			"黄色长条是「连打」：在长条经过时连续敲任意鼓键，胡旋转得越快。",
			"判定：良 ±45 毫秒，可 ±100 毫秒。准确率 70% 过关（简单模式 60%）。Esc 放弃本次。",
			"P 随时切换自动演奏，也可点画面右下角按钮；自动演奏的成绩单独标记。"]
	return ["点击发光标记打听消息。", "问齐之后去找米娜，她会让你为她击鼓伴舞。"]


func journal_lines() -> Array:
	var out := []
	if asked.has("barkeep"):
		out.append("酒家胡：卖瓷片的少年叫阿拾，欠了店里的酒钱，躲在楼上。")
	if asked.has("drum"):
		out.append("羯鼓：唐玄宗最爱的鼓，「八音之领袖」。两面蒙皮，以双杖击之。")
	if asked.has("stairs"):
		out.append("楼上帘后有人影，一动不动。米娜说她能叫他下来。")
	if out.is_empty():
		out.append("先在酒肆里打听那个卖瓷片的少年。")
	return out


func hint() -> String:
	match phase:
		"explore":
			for id in ["barkeep", "stairs", "drum"]:
				if not asked.has(id):
					return "还没问过：" + SPOTS[id]["label"] + "。"
			return "问齐了，点击米娜。"
		"ready":
			return "点击「开始击鼓」。觉得太快可以先选简单模式。"
		"play":
			return "跟着鼓点的位置敲，不要只听音乐。看金色圆圈。"
		"result":
			return "差一点。试试简单模式：音符少一些，判定线也更宽。" if not result.get("pass", false) else "过关了。"
	return "阿拾已经下楼。"


# ================================================================== chart / judging (pure logic)
func make_notes(want_easy: bool) -> Array:
	var out := []
	for n in Chart.NOTES:
		if want_easy and not n["easy"]:
			continue
		var c: Dictionary = n.duplicate()
		c["done"] = false
		c["res"] = ""
		out.append(c)
	return out


func great_window() -> float:
	return GREAT * (1.3 if easy else 1.0)


func good_window() -> float:
	return GOOD * (1.3 if easy else 1.0)


## Judges one key press of kind ("don" / "ka") at song time t. Returns "great" / "good" /
## "wrong" / "roll" / "" (nothing near).
func press(kind: String, t: float) -> String:
	if phase != "play":
		return ""
	drum_flash[kind] = 0.12
	g.sfx("hux_" + kind, -4)
	var best: Dictionary = {}
	var best_dt := 99.0
	for n in notes:
		if n["done"] or n["k"] == "roll":
			continue
		var dt := absf(t - float(n["t"]))
		if dt < best_dt:
			best_dt = dt
			best = n
		if float(n["t"]) > t + good_window():
			break
	if best.is_empty() or best_dt > good_window():
		# No regular note in reach: count it toward a roll that is passing the drum.
		for n in notes:
			if n["k"] == "roll" and not n["done"] and t >= float(n["t"]) - 0.05 and t < float(n["t"]) + float(n["d"]):
				_hit_roll()
				return "roll"
		return ""
	if best["k"] != kind:
		_judge(best, "miss")
		return "wrong"
	var res := "great" if best_dt <= great_window() else "good"
	_judge(best, res)
	return res


func _hit_roll() -> void:
	roll_hits += 1
	score += 120
	spin_speed += 1.2
	drum_flash["don"] = 0.12


func set_autoplay(enabled: bool) -> void:
	autoplay = enabled
	if phase == "play" and enabled:
		auto_used = true


## Process the crossed interval, rather than relying on one note arriving in one frame.
func _autoplay_between(from: float, to: float) -> void:
	if not autoplay or to <= from:
		return
	for n in notes:
		if n["done"]:
			continue
		var t := float(n["t"])
		if n["k"] == "roll":
			var first := maxi(0, int(floor((from - t) * 12.0)) + 1)
			var last := mini(int(floor((to - t) * 12.0)), int(ceil(float(n["d"]) * 12.0)) - 1)
			for i in range(first, last + 1):
				_hit_roll()
			if last >= first:
				g.sfx("hux_don", -10)
		elif t > from and t <= to:
			press(str(n["k"]), t)


func _judge(n: Dictionary, res: String) -> void:
	n["done"] = true
	n["res"] = res
	counts[res] += 1
	match res:
		"great":
			combo += 1
			score += 300 + mini(combo, 50) * 10
			_show_judge("良", Color("ffd27a"))
		"good":
			combo += 1
			score += 120 + mini(combo, 50) * 4
			_show_judge("可", Color("cfe8ff"))
		"miss":
			combo = 0
			_show_judge("不可", Color("ff7a6a"))
	best_combo = maxi(best_combo, combo)
	spin_speed += 2.5 if res == "great" else (1.2 if res == "good" else -3.0)


func _show_judge(text: String, c: Color) -> void:
	judge_text = text
	judge_col = c
	judge_t = 0.5


## Marks notes whose window has passed as misses and closes finished rolls.
func sweep(t: float) -> void:
	for n in notes:
		if n["done"]:
			continue
		if n["k"] == "roll":
			if t > float(n["t"]) + float(n["d"]):
				n["done"] = true
			continue
		if t > float(n["t"]) + good_window():
			_judge(n, "miss")


## Accuracy: 良 counts fully, 可 counts half.
func accuracy() -> float:
	var total := 0
	for n in notes:
		if n["k"] != "roll":
			total += 1
	if total == 0:
		return 0.0
	return (counts["great"] + counts["good"] * 0.5) / float(total)


func section_at(t: float) -> int:
	var s := 0
	for i in range(Chart.SECTIONS.size()):
		if t >= float(Chart.SECTIONS[i]["start"]):
			s = i
	return s


# ================================================================== flow
func act(id: String) -> void:
	if _common_act(id):
		return
	if SPOTS.has(id):
		_ask(id)
		return
	match id:
		"mi":
			if phase == "explore":
				if asked.has("barkeep") and asked.has("stairs") and asked.has("drum"):
					g.say("mi_challenge", func() -> void: phase = "ready")
				else:
					g.say("mi_brush")
			elif phase == "ready":
				pass
		"start":
			start_song(false)
		"start_easy":
			start_song(true)
		"toggle_auto":
			set_autoplay(not autoplay)
		"retry":
			start_song(easy)
		"claim":
			_win()
		"to_map":
			g.go("map")


func _ask(id: String) -> void:
	asked[id] = true
	match id:
		"barkeep":
			g.say("hux_barkeep")
		"stairs":
			g.say("hux_stairs")
		"drum":
			g.show_card("jiegu")
		"jar":
			g.show_card("grape_wine")


func start_song(want_easy: bool) -> void:
	easy = want_easy
	notes = make_notes(easy)
	combo = 0
	best_combo = 0
	score = 0
	roll_hits = 0
	counts = {"great": 0, "good": 0, "miss": 0}
	spin_speed = 0.0
	spin = 0.0
	sleeves.clear()
	auto_used = autoplay
	end_t = 0.0
	section_mix = 0.0
	section_banner = 0.0
	result = {}
	test_clock = -INF
	stop_song()
	last_section = -1
	song_t = -LEAD
	phase = "play"
	g.music("", false)
	start_ms = Time.get_ticks_msec() + int(LEAD * 1000)
	if not g.test_mode:
		if not player:
			player = AudioStreamPlayer.new()
			player.bus = &"Music"
			player.volume_db = -4
			add_child(player)
		player.stream = g.tracks.get("huxuan")


func stop_song() -> void:
	if player:
		player.stop()


func finish_song() -> void:
	stop_song()
	sweep(9999.0)
	var acc := accuracy()
	var need := PASS_EASY if easy else PASS
	result = {"acc": acc, "pass": acc >= need, "need": need, "auto": auto_used}
	phase = "result"
	end_t = 0.0
	g.music("ambient")
	if result["pass"]:
		g.sfx("hux_cheer", -2)
		if not auto_used:
			g.stats["dance_acc"] = maxf(float(g.stats.get("dance_acc", 0.0)), acc)
	else:
		g.sfx("error", -8)


func _win() -> void:
	phase = "done"
	g.flags["ashi_joined"] = true
	g.say("hux_win", func() -> void:
		g.show_card("huxuan")
		g.clear("ch3")
		g.notify("第三章完成。阿拾加入了。赶在清扫前到慈恩寺报失，请僧人留住最后一片。", 8))


## Current song time. Uses the audio clock when the track is playing (keeps notes in sync
## with what is heard), otherwise wall time from the scheduled start.
func clock() -> float:
	if test_clock > -INF:
		return test_clock
	if player and player.playing:
		return player.get_playback_position() + AudioServer.get_time_since_last_mix() - AudioServer.get_output_latency()
	return (Time.get_ticks_msec() - start_ms) / 1000.0


func tick(delta: float, blocked: bool) -> void:
	judge_t = maxf(0.0, judge_t - delta)
	section_banner = maxf(0.0, section_banner - delta)
	for k in drum_flash:
		drum_flash[k] = maxf(0.0, drum_flash[k] - delta)
	spin_speed = clampf(lerpf(spin_speed, float(mini(combo, 40)) * 0.35 + 2.0, delta * 1.5), 0.0, 28.0)
	if phase == "play" and not blocked:
		var was := song_t
		song_t = clock()
		if player and not player.playing and was < 0.0 and song_t >= 0.0 and player.stream:
			player.play()
		var s := section_at(maxf(song_t, 0.0))
		if s != last_section and song_t >= 0.0:
			last_section = s
			section_banner = 2.2
		section_mix = move_toward(section_mix, float(s), delta * 0.8)
		_autoplay_between(was, song_t)
		sweep(song_t)
		if song_t >= Chart.END + 1.0:
			finish_song()
	else:
		spin_speed = lerpf(spin_speed, 1.2, delta)
	if phase == "result":
		end_t += delta
	spin += spin_speed * delta
	sleeves.push_front(Vector3(cos(spin), sin(spin), 0))
	if sleeves.size() > 18:
		sleeves.pop_back()


func key(event: InputEventKey) -> bool:
	if phase in ["ready", "play"] and event.keycode == KEY_P and not g.blocked():
		if not event.echo:
			set_autoplay(not autoplay)
		return true
	if phase != "play" or g.blocked():
		return false
	match event.keycode:
		KEY_F, KEY_J, KEY_SPACE:
			press("don", song_t)
		KEY_D, KEY_K:
			press("ka", song_t)
		KEY_ESCAPE:
			stop_song()
			phase = "ready"
			g.music("ambient")
			g.notify("已放弃本次击鼓。")
			g.overlay.open_help()
	return true                       # swallow other keys (J / H) so panels don't open mid-song


func mouse(event: InputEvent) -> bool:
	if phase != "play" or g.blocked():
		return false
	if event is InputEventMouseButton and event.pressed:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if Rect2(1100, 841, 270, 34).has_point(event.position):
				set_autoplay(not autoplay)
				return true
			press("don", song_t)
			return true
		if event.button_index == MOUSE_BUTTON_RIGHT:
			press("ka", song_t)
			return true
	return false


# ================================================================== drawing
func _draw() -> void:
	hit_regions.clear()
	if phase in ["play", "result"]:
		_draw_dance()
		return
	var goals := [
		{"t": "打听", "d": "问清卖瓷片的少年在哪", "done": asked.has("barkeep") and asked.has("stairs") and asked.has("drum")},
		{"t": "胡旋", "d": "为米娜击鼓伴舞", "done": phase == "done"},
		{"t": "阿拾", "d": "见到捡碎瓷的少年", "done": phase == "done"},
	]
	var obj := "在酒肆里打听那个卖瓷片的少年。"
	if goals[0]["done"] and phase == "explore":
		obj = "问齐了。点击米娜。"
	elif phase == "ready":
		obj = "准备击鼓。"
	elif phase == "done":
		obj = "阿拾带路，趁夜去慈恩寺说明失物来历。"
	_frame("第三章  ·  胡旋", "西市 · 胡姬酒肆  /  闭市后 · 灯下", goals, obj, [])
	if not _img_cover("tavern", ROOM):
		draw_rect(bleed(), Color("2a1c18"))
	draw_rect(bleed(), Color(0.02, 0.02, 0.03, 0.1))
	var talking: bool = g.dlg.active and g.dlg.entry().get("w", "") == "mi"
	if not talking:
		_figure("npc_mi", MI_FOOT, 400)
	if not (g.dlg.active and g.dlg.entry().get("w", "") == "jiujia"):
		_figure("npc_jiujia", Vector2(984, 752), 302)
	if phase == "done":
		_next_button("to_map", "回长安舆图  ›")
	if g.blocked():
		return
	for id in SPOTS:
		_hotspot(id, SPOTS[id]["p"], SPOTS[id]["label"], SPOTS[id]["r"], asked.has(id))
	if phase == "explore":
		_hotspot("mi", MI_FOOT + Vector2(0, -420), "米娜" + ("  · 请她叫人" if goals[0]["done"] else ""), Rect2(MI_FOOT + Vector2(-80, -400), Vector2(160, 400)))
	if phase == "ready":
		_hud(_draw_ready_card)


func _draw_ready_card() -> void:
	_modal_back(0.6)
	_panel(Rect2(390, 280, 660, 350))
	_title_center(720, 338, "胡旋 · 羯鼓", 34, Pal.PAPER)
	_tc(720, 377, "散序起势 / 中序回旋 / 入破急转  ·  约 80 秒", 16, Pal.GOLD)
	_tc(720, 416, "咚 F / J / 左键      嗒 D / K / 右键      连打：连续敲击", 15, Pal.SOFT)
	_button("toggle_auto", Rect2(450, 444, 540, 42), "自动演奏：" + ("开" if autoplay else "关") + "    P 切换", autoplay, 16)
	_tc(720, 510, "自动演奏同样可以过关，演出中也能随时切换。", 15, Pal.MUTED)
	_button("start", Rect2(450, 542, 260, 50), "开始击鼓", true, 18)
	_button("start_easy", Rect2(730, 542, 260, 50), "简单模式", false, 16)


func _x_for(t_note: float) -> float:
	return HIT_X + (t_note - song_t) / LEAD * (LANE.end.x - HIT_X - 40)


func _live_acc() -> float:
	var judged: float = counts["great"] + counts["good"] + counts["miss"]
	if judged == 0:
		return 1.0
	return (counts["great"] + counts["good"] * 0.5) / judged


func dance_state() -> Dictionary:
	var s := section_at(maxf(song_t, 0.0))
	var state := Visuals.movement(song_t, s, float(Chart.SECTIONS[s]["bpm"]), float(Chart.SECTIONS[s]["start"]), combo)
	if phase == "result":
		state["frame"] = 0
		state["next"] = 0
		state["blend"] = 0.0
		state["sway"] = sin(end_t * 2.0) * 0.006
		state["step"] = 0.0
		state["strength"] *= maxf(0.0, 1.0 - end_t)
	return state


func _draw_dance() -> void:
	var s := section_at(maxf(song_t, 0.0))
	var look: Dictionary = Visuals.LOOKS[s]
	var state := dance_state()
	var tint := Color(0.62, 0.68, 0.71).lerp(Color(0.87, 0.72, 0.59), section_mix / 2.0)
	if not _img_cover("tavern", Rect2(0, 0, 1440, 900), tint):
		draw_rect(Rect2(0, 0, 1440, 900), Color("1d1416"))
	draw_rect(Rect2(0, 0, 1440, 900), Color(0.03, 0.02, 0.03, 0.12))
	for i in range(8):
		draw_rect(Rect2(0, i * 19, 1440, 19), Color(0, 0, 0, 0.10 * (1.0 - i / 8.0)))
		draw_rect(Rect2(0, 900 - (i + 1) * 16, 1440, 16), Color(0, 0, 0, 0.14 * (1.0 - i / 8.0)))
	var cc := Vector2(720, 646)
	var light: Color = look["light"]
	for r in range(7, 0, -1):
		draw_circle(cc + Vector2(0, -240), 120 + r * 25, Color(light, 0.012 + float(state["pulse"]) * 0.003))
	draw_set_transform(cc + Vector2(0, 4), 0.0, Vector2(1, 0.18))
	draw_circle(Vector2.ZERO, 98, Color(0.03, 0.015, 0.01, 0.34))
	draw_set_transform(Vector2.ZERO)
	_draw_silk(cc, state, false)
	_draw_dancer(cc, state)
	_draw_silk(cc, state, true)
	for i in range(12 + s * 9):
		var t := maxf(song_t, 0.0)
		var px := 300.0 + fposmod(i * 127.3 + sin(t * 0.3 + i) * 25.0, 840.0)
		var py := 685.0 - fposmod(i * 73.1 + t * (12.0 + i % 5 * 3.0), 520.0)
		var alpha := (0.12 + s * 0.04) * (0.5 + 0.5 * sin(t * 1.5 + i))
		draw_circle(Vector2(px, py), 1.0 + i % 3 * 0.4, Color(light, alpha))
	_t(Vector2(72, 30), "CHAPTER 03 / HUXUAN", 12, Pal.GOLD)
	_title(Vector2(72, 66), "胡旋  ·  羯鼓", 27, Pal.PAPER)
	for i in range(3):
		var c := Pal.GOLD if i == s else (Pal.JADE if i < s else Color("718079"))
		draw_line(Vector2(72 + i * 110, 85), Vector2(170 + i * 110, 85), Color(c, 0.65), 2)
		_title_center(121 + i * 110, 116, str(Chart.SECTIONS[i]["name"]), 21, c)
	_t(Vector2(72, 145), "%s  ·  %d BPM" % ["简单模式" if easy else "普通", int(Chart.SECTIONS[s]["bpm"])], 14, Pal.MUTED)
	_title_center(720, 66, str(look["name"]), 40, look["ink"])
	_tc(720, 99, str(look["caption"]), 16, Pal.SOFT)
	_t(Vector2(1150, 42), "演奏得分", 14, Pal.GOLD)
	_t(Vector2(1150, 80), "%07d" % score, 30, Pal.PAPER)
	_t(Vector2(1150, 110), "准确率 %d%%" % int(round(_live_acc() * 100)), 16, Pal.GOLD)
	_box(Rect2(1150, 127, 180, 29), Color(0.10, 0.075, 0.04, 0.8), 3, Color(Pal.GOLD, 0.55))
	_tc(1240, 147, "自动演奏中" if autoplay else "手动演奏", 14, Pal.GOLD)
	if combo >= 3:
		_title_center(1198, 392, "%d" % combo, 70 + int(float(state["pulse"]) * 4), Color("ffdfa0"))
		_title_center(1198, 429, "连击", 27, Pal.GOLD)
	if section_banner > 0 and song_t >= 0.0:
		var alpha := minf(1.0, section_banner)
		_title(Vector2(132, 330), str(look["name"]), 56, Color(look["ink"], alpha))
		_t(Vector2(132, 364), str(look["caption"]), 16, Color(Pal.SOFT, alpha))
	_draw_lane()
	if judge_t > 0:
		var k := judge_t / 0.5
		_title_center(HIT_X, LANE.position.y - 28 - (1.0 - k) * 16, judge_text, 32, Color(judge_col, k))
	_button("toggle_auto", Rect2(1100, 841, 270, 34), "自动演奏：" + ("开" if autoplay else "关") + "  P", autoplay, 14)
	var prog := clampf(song_t / Chart.END, 0.0, 1.0)
	draw_rect(Rect2(70, 886, 1300, 2), Color(0.2, 0.2, 0.2, 0.7))
	draw_rect(Rect2(70, 886, 1300 * prog, 2), Pal.GOLD)
	if song_t < 0.0 and phase == "play":
		_box(Rect2(650, 330, 140, 116), Color(0.04, 0.03, 0.02, 0.7), 6, Color(Pal.GOLD, 0.7))
		_title_center(720, 410, str(int(ceil(-song_t))), 64, Pal.PAPER)
	if phase == "result" and end_t > 0.7:
		_draw_result()


func _draw_lane() -> void:
	_box(LANE, Color(0.04, 0.05, 0.06, 0.88), 10, Color(0.84, 0.72, 0.48, 0.6))
	var y := LANE.get_center().y
	var c := Vector2(HIT_X, y)
	# The drum: the head lights for 咚, the rim for 嗒.
	draw_circle(c, 46, Color("3b2a20"))
	draw_circle(c, 40, Color(0.9, 0.55, 0.35, 0.35 + drum_flash["don"] * 4.0))
	draw_arc(c, 46, 0, TAU, 40, Color(0.55, 0.8, 1.0, 0.5 + drum_flash["ka"] * 4.0), 5, true)
	draw_arc(c, 52, 0, TAU, 40, Pal.GOLD, 2, true)
	for i in range(notes.size() - 1, -1, -1):
		var n: Dictionary = notes[i]
		var t0 := float(n["t"])
		if t0 - song_t > LEAD + 0.2:
			continue
		if n["k"] == "roll":
			var x0 := maxf(_x_for(t0), HIT_X)
			var x1 := minf(_x_for(t0 + float(n["d"])), LANE.end.x - 60)
			if x1 < HIT_X - 10 or n["done"]:
				continue
			_box(Rect2(x0 - 30, y - 26, maxf(x1 - x0, 0) + 60, 52), Color(1, 0.8, 0.3, 0.75), 26, Color("ffe7a0"), 2)
			_title_center(maxf(x0, HIT_X) + 3, y + 11, "连打", 25, Pal.INK)
			continue
		if n["done"] and n["res"] != "miss":
			continue
		var x := _x_for(t0)
		if x < LANE.position.x - 20 or x > LANE.end.x - 30:
			continue
		var don: bool = n["k"] == "don"
		var col := Color("e0533e") if don else Color("3f8fd6")
		var r := 30.0 if don else 26.0
		if n["done"]:
			col = Color(0.3, 0.3, 0.3, 0.6)
		draw_circle(Vector2(x, y), r + 4, Color("f3e3c0"))
		draw_circle(Vector2(x, y), r, col)
		_title_center(x, y + 11, "咚" if don else "嗒", 30, Color.WHITE)
	_t(Vector2(LANE.position.x + 12, LANE.end.y + 39), "咚  F / J / 左键", 14, Color("ff9a86"))
	_t(Vector2(LANE.position.x + 180, LANE.end.y + 39), "嗒  D / K / 右键", 14, Color("8fc4ff"))
	_t(Vector2(LANE.position.x + 350, LANE.end.y + 39), "连打  狂敲任意键", 14, Color("ffd27a"))
	_t(Vector2(LANE.position.x + 640, LANE.end.y + 39), "Esc 退出演奏", 14, Pal.MUTED)


## Eight aligned poses share one foot anchor.
func _draw_dancer(foot: Vector2, state: Dictionary) -> void:
	var h := 505.0
	var w := h * 560.0 / 720.0
	var anchor := foot + Vector2(sin(float(state["beat"]) * PI) * 3.0, float(state["step"]))
	draw_set_transform(anchor, float(state["sway"]))
	var rect := Rect2(-w * 0.5, -h * 704.0 / 720.0, w, h)
	var blend := float(state["blend"])
	var current := "mi_dance_%d" % int(state["frame"])
	var following := "mi_dance_%d" % int(state["next"])
	if g.tex.has(current):
		draw_texture_rect(g.tex[current], rect, false, Color(1, 1, 1, 1.0 - blend))
	if blend > 0.0 and g.tex.has(following):
		draw_texture_rect(g.tex[following], rect, false, Color(1, 1, 1, blend))
	draw_set_transform(Vector2.ZERO)


func _draw_silk(foot: Vector2, state: Dictionary, front: bool) -> void:
	var strength := float(state["strength"])
	if strength < 0.01:
		return
	var s := section_at(maxf(song_t, 0.0))
	var angle := float(state["beat"]) * TAU / float(Visuals.LOOKS[s]["turn_beats"])
	for ribbon in range(2):
		for i in range(31):
			var a := angle - i * 0.075 + ribbon * PI
			if (sin(a) > 0.0) != front:
				continue
			var b := a - 0.075
			var pa := foot + Vector2(cos(a) * (130.0 + strength * 64.0), -265 + sin(a) * 56.0 + i * 2.8)
			var pb := foot + Vector2(cos(b) * (130.0 + strength * 64.0), -265 + sin(b) * 56.0 + (i + 1) * 2.8)
			var color := Color("e9c383") if ribbon == 0 else Color("ce7356")
			color.a = strength * (1.0 - i / 32.0) * 0.45
			draw_line(pa, pb, color, 2.0 + strength * 3.0, true)


func _draw_result() -> void:
	draw_rect(Rect2(0, 0, 1440, 900), Color(0, 0, 0, 0.5))
	_panel(Rect2(420, 220, 600, 440))
	var ok: bool = result.get("pass", false)
	_title_center(720, 290, "满堂喝彩！" if ok else "鼓点乱了……", 38, Pal.PAPER if ok else Color("ffb0a0"))
	_tc(720, 328, "自动演奏" if result.get("auto", false) else "手动演奏", 16, Pal.MUTED)
	_tc(720, 375, "准确率  %d%%   （需要 %d%%）" % [int(round(result.get("acc", 0.0) * 100)), int(result.get("need", PASS) * 100)], 18, Pal.GOLD)
	_tc(720, 415, "良 %d   可 %d   不可 %d   连打 %d" % [counts["great"], counts["good"], counts["miss"], roll_hits], 16, Pal.SOFT)
	_tc(720, 451, "最大连击 %d   ·   得分 %d" % [best_combo, score], 15, Pal.MUTED)
	if ok:
		_button("claim", Rect2(560, 495, 320, 50), "去见阿拾", true, 18)
	else:
		_button("retry", Rect2(500, 495, 210, 50), "再来一次", true, 17)
		_button("start_easy", Rect2(730, 495, 210, 50), "简单模式", false, 16)
	_button("to_map", Rect2(620, 585, 200, 40), "返回舆图", false, 14)


