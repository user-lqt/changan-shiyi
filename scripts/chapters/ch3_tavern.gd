extends "res://scripts/core/canvas.gd"
## 第三章 · 胡旋: the Sogdian tavern behind the West Market.
## Part A (调查): ask around for the boy who sold the shard; the dancer 米娜 says he owes the
##   house a debt and is hiding upstairs. She will only call him down if Su beats the jiegu
##   drum for her 胡旋舞.
## Part B (击鼓): a rhythm game in the three sections of a Tang 大曲 (散序 · 中序 · 入破).
##   Notes slide along a lane toward the drum. F / J (or left click) = 咚 centre,
##   D / K (or right click) = 嗒 rim, a roll (连打) takes any drum key repeatedly.
##   Judgement: 良 ±45 ms, 可 ±100 ms, else 不可. The dancer spins faster with the combo.
## Passing needs 70 % accuracy (60 % in easy mode); the chart is generated by tools/build_huxuan.py.

const Story = preload("res://scripts/data/story.gd")
const Chart = preload("res://scripts/data/huxuan_chart.gd")
const Visuals = preload("res://scripts/data/huxuan_visuals.gd")
const GREAT := 0.045
const GOOD := 0.10
const LEAD := 2.0                     # seconds a note is visible before it reaches the drum
const LANE := Rect2(70, 708, 1300, 108)
const HIT_X := 210.0
const PASS := 0.70
const PASS_EASY := 0.60
const SPOTS := {
	"barkeep": {"p": Vector2(905, 420), "label": "酒家胡", "r": Rect2(840, 360, 140, 150)},
	"jar": {"p": Vector2(330, 560), "label": "葡萄酒瓮", "r": Rect2(270, 500, 130, 110)},
	"drum": {"p": Vector2(1015, 560), "label": "羯鼓", "r": Rect2(950, 500, 130, 110)},
	"stairs": {"p": Vector2(640, 300), "label": "楼梯 · 楼上帘后", "r": Rect2(570, 240, 150, 120)},
}
const MI_FOOT := Vector2(560, 772)

var phase := "explore"                # explore | ready | play | result | done
var asked := {}
var easy := false
var notes: Array = []                 # active chart: copies of Chart.NOTES with state
var song_t := -LEAD                   # song clock (negative = count-in)
var start_ms := 0
var result := {}
var combo := 0
var best_combo := 0
var score := 0
var counts := {"great": 0, "good": 0, "miss": 0}
var roll_hits := 0
var judge_text := ""
var judge_t := 0.0
var judge_col := Color.WHITE
var drum_flash := {"don": 0.0, "ka": 0.0}
var spin := 0.0                       # dancer spin angle
var spin_speed := 0.0
var sleeves: Array[Vector3] = []      # trailing ribbon points
var section_banner := 0.0
var last_section := -1
var player: AudioStreamPlayer
var test_clock := -INF                # captures pin the clock here; -INF = use the real clock
var autoplay := false
var auto_used := false
var end_t := 0.0
var section_mix := 0.0


func enter() -> void:
	g.music("ambient")
	g.say("ch3_arrive")


func chrome() -> bool:
	return phase != "play"


func staged() -> bool:
	return phase in ["explore", "ready", "done"]


func help_lines() -> Array:
	if phase in ["ready", "play"]:
		return ["鼓点从右往左滑向羯鼓。到达金色圆圈时敲击。",
			"红色「咚」：F / J 或鼠标左键。蓝色「嗒」：D / K 或鼠标右键。",
			"黄色长条是「连打」：在长条经过时连续敲任意鼓键，胡旋转得越快。",
			"判定：良 ±45 毫秒，可 ±100 毫秒。准确率 70% 过关（简单模式 60%）。Esc 放弃本次。",
			"P 随时切换自动演奏，也可点画面右下角按钮；自动演奏的成绩单独标记。"]
	return ["点击发光标记打听消息。", "问齐之后去找米娜，她会让你为她击鼓伴舞。"]


func journal_lines() -> Array:
	var out := []
	if asked.has("barkeep"):
		out.append("酒家胡：卖瓷片的少年叫阿拾，欠了店里的酒钱，躲在楼上。")
	if asked.has("drum"):
		out.append("羯鼓：唐玄宗最爱的鼓，「八音之领袖」。两面蒙皮，以双杖击之。")
	if asked.has("stairs"):
		out.append("楼上帘后有人影，一动不动。米娜说她能叫他下来。")
	if out.is_empty():
		out.append("先在酒肆里打听那个卖瓷片的少年。")
	return out


func hint() -> String:
	match phase:
		"explore":
			for id in ["barkeep", "stairs", "drum"]:
				if not asked.has(id):
					return "还没问过：" + SPOTS[id]["label"] + "。"
			return "问齐了，点击米娜。"
		"ready":
			return "点击「开始击鼓」。觉得太快可以先选简单模式。"
		"play":
			return "跟着鼓点的位置敲，不要只听音乐。看金色圆圈。"
		"result":
			return "差一点。试试简单模式：音符少一些，判定线也更宽。" if not result.get("pass", false) else "过关了。"
	return "阿拾已经下楼。"


# ================================================================== chart / judging (pure logic)
func make_notes(want_easy: bool) -> Array:
	var out := []
	for n in Chart.NOTES:
		if want_easy and not n["easy"]:
			continue
		var c: Dictionary = n.duplicate()
		c["done"] = false
		c["res"] = ""
		out.append(c)
	return out


func great_window() -> float:
	return GREAT * (1.3 if easy else 1.0)


func good_window() -> float:
	return GOOD * (1.3 if easy else 1.0)


## Judges one key press of kind ("don" / "ka") at song time t. Returns "great" / "good" /
## "wrong" / "roll" / "" (nothing near).
func press(kind: String, t: float) -> String:
	if phase != "play":
		return ""
	drum_flash[kind] = 0.12
	g.sfx("hux_" + kind, -4)
	var best: Dictionary = {}
	var best_dt := 99.0
	for n in notes:
		if n["done"] or n["k"] == "roll":
			continue
		var dt := absf(t - float(n["t"]))
		if dt < best_dt:
			best_dt = dt
			best = n
		if float(n["t"]) > t + good_window():
			break
	if best.is_empty() or best_dt > good_window():
		# No regular note in reach: count it toward a roll that is passing the drum.
		for n in notes:
			if n["k"] == "roll" and not n["done"] and t >= float(n["t"]) - 0.05 and t < float(n["t"]) + float(n["d"]):
				_hit_roll()
				return "roll"
		return ""
	if best["k"] != kind:
		_judge(best, "miss")
		return "wrong"
	var res := "great" if best_dt <= great_window() else "good"
	_judge(best, res)
	return res


func _hit_roll() -> void:
	roll_hits += 1
	score += 120
	spin_speed += 1.2
	drum_flash["don"] = 0.12


func set_autoplay(enabled: bool) -> void:
	autoplay = enabled
	if phase == "play" and enabled:
		auto_used = true


## Process the crossed interval, rather than relying on one note arriving in one frame.
func _autoplay_between(from: float, to: float) -> void:
	if not autoplay or to <= from:
		return
	for n in notes:
		if n["done"]:
			continue
		var t := float(n["t"])
		if n["k"] == "roll":
			var first := maxi(0, int(floor((from - t) * 12.0)) + 1)
			var last := mini(int(floor((to - t) * 12.0)), int(ceil(float(n["d"]) * 12.0)) - 1)
			for i in range(first, last + 1):
				_hit_roll()
			if last >= first:
				g.sfx("hux_don", -10)
		elif t > from and t <= to:
			press(str(n["k"]), t)


func _judge(n: Dictionary, res: String) -> void:
	n["done"] = true
	n["res"] = res
	counts[res] += 1
	match res:
		"great":
			combo += 1
			score += 300 + mini(combo, 50) * 10
			_show_judge("良", Color("ffd27a"))
		"good":
			combo += 1
			score += 120 + mini(combo, 50) * 4
			_show_judge("可", Color("cfe8ff"))
		"miss":
			combo = 0
			_show_judge("不可", Color("ff7a6a"))
	best_combo = maxi(best_combo, combo)
	spin_speed += 2.5 if res == "great" else (1.2 if res == "good" else -3.0)


func _show_judge(text: String, c: Color) -> void:
	judge_text = text
	judge_col = c
	judge_t = 0.5


## Marks notes whose window has passed as misses and closes finished rolls.
func sweep(t: float) -> void:
	for n in notes:
		if n["done"]:
			continue
		if n["k"] == "roll":
			if t > float(n["t"]) + float(n["d"]):
				n["done"] = true
			continue
		if t > float(n["t"]) + good_window():
			_judge(n, "miss")


## Accuracy: 良 counts fully, 可 counts half.
func accuracy() -> float:
	var total := 0
	for n in notes:
		if n["k"] != "roll":
			total += 1
	if total == 0:
		return 0.0
	return (counts["great"] + counts["good"] * 0.5) / float(total)


func section_at(t: float) -> int:
	var s := 0
	for i in range(Chart.SECTIONS.size()):
		if t >= float(Chart.SECTIONS[i]["start"]):
			s = i
	return s


# ================================================================== flow
func act(id: String) -> void:
	if _common_act(id):
		return
	if SPOTS.has(id):
		_ask(id)
		return
	match id:
		"mi":
			if phase == "explore":
				if asked.has("barkeep") and asked.has("stairs") and asked.has("drum"):
					g.say("mi_challenge", func() -> void: phase = "ready")
				else:
					g.say("mi_brush")
			elif phase == "ready":
				pass
		"start":
			start_song(false)
		"start_easy":
			start_song(true)
		"toggle_auto":
			set_autoplay(not autoplay)
		"retry":
			start_song(easy)
		"claim":
			_win()
		"to_map":
			g.go("map")


func _ask(id: String) -> void:
	asked[id] = true
	match id:
		"barkeep":
			g.say("hux_barkeep")
		"stairs":
			g.say("hux_stairs")
		"drum":
			g.show_card("jiegu")
		"jar":
			g.show_card("grape_wine")


func start_song(want_easy: bool) -> void:
	easy = want_easy
	notes = make_notes(easy)
	combo = 0
	best_combo = 0
	score = 0
	roll_hits = 0
	counts = {"great": 0, "good": 0, "miss": 0}
	spin_speed = 0.0
	spin = 0.0
	sleeves.clear()
	auto_used = autoplay
	end_t = 0.0
	section_mix = 0.0
	section_banner = 0.0
	result = {}
	test_clock = -INF
	stop_song()
	last_section = -1
	song_t = -LEAD
	phase = "play"
	g.music("", false)
	start_ms = Time.get_ticks_msec() + int(LEAD * 1000)
	if not g.test_mode:
		if not player:
			player = AudioStreamPlayer.new()
			player.volume_db = -4
			add_child(player)
		player.stream = g.tracks.get("huxuan")


func stop_song() -> void:
	if player:
		player.stop()


func finish_song() -> void:
	stop_song()
	sweep(9999.0)
	var acc := accuracy()
	var need := PASS_EASY if easy else PASS
	result = {"acc": acc, "pass": acc >= need, "need": need, "auto": auto_used}
	phase = "result"
	end_t = 0.0
	g.music("ambient")
	if result["pass"]:
		g.sfx("hux_cheer", -2)
		if not auto_used:
			g.stats["dance_acc"] = maxf(float(g.stats.get("dance_acc", 0.0)), acc)
	else:
		g.sfx("error", -8)


func _win() -> void:
	phase = "done"
	g.flags["ashi_joined"] = true
	g.say("hux_win", func() -> void:
		g.show_card("huxuan")
		g.clear("ch3")
		g.notify("第三章完成。阿拾加入了。今夜就穿城去大雁塔。", 8))


## Current song time. Uses the audio clock when the track is playing (keeps notes in sync
## with what is heard), otherwise wall time from the scheduled start.
func clock() -> float:
	if test_clock > -INF:
		return test_clock
	if player and player.playing:
		return player.get_playback_position() + AudioServer.get_time_since_last_mix() - AudioServer.get_output_latency()
	return (Time.get_ticks_msec() - start_ms) / 1000.0


func tick(delta: float, blocked: bool) -> void:
	judge_t = maxf(0.0, judge_t - delta)
	section_banner = maxf(0.0, section_banner - delta)
	for k in drum_flash:
		drum_flash[k] = maxf(0.0, drum_flash[k] - delta)
	spin_speed = clampf(lerpf(spin_speed, float(mini(combo, 40)) * 0.35 + 2.0, delta * 1.5), 0.0, 28.0)
	if phase == "play" and not blocked:
		var was := song_t
		song_t = clock()
		if player and not player.playing and was < 0.0 and song_t >= 0.0 and player.stream:
			player.play()
		var s := section_at(maxf(song_t, 0.0))
		if s != last_section and song_t >= 0.0:
			last_section = s
			section_banner = 2.2
		section_mix = move_toward(section_mix, float(s), delta * 0.8)
		_autoplay_between(was, song_t)
		sweep(song_t)
		if song_t >= Chart.END + 1.0:
			finish_song()
	else:
		spin_speed = lerpf(spin_speed, 1.2, delta)
	if phase == "result":
		end_t += delta
	spin += spin_speed * delta
	sleeves.push_front(Vector3(cos(spin), sin(spin), 0))
	if sleeves.size() > 18:
		sleeves.pop_back()


func key(event: InputEventKey) -> bool:
	if phase in ["ready", "play"] and event.keycode == KEY_P and not g.blocked():
		if not event.echo:
			set_autoplay(not autoplay)
		return true
	if phase != "play" or g.blocked():
		return false
	match event.keycode:
		KEY_F, KEY_J, KEY_SPACE:
			press("don", song_t)
		KEY_D, KEY_K:
			press("ka", song_t)
		KEY_ESCAPE:
			stop_song()
			phase = "ready"
			g.music("ambient")
			g.notify("已放弃本次击鼓。")
	return true                       # swallow other keys (J / H) so panels don't open mid-song


func mouse(event: InputEvent) -> bool:
	if phase != "play" or g.blocked():
		return false
	if event is InputEventMouseButton and event.pressed:
		if event.button_index == MOUSE_BUTTON_LEFT:
			if Rect2(1100, 841, 270, 34).has_point(event.position):
				set_autoplay(not autoplay)
				return true
			press("don", song_t)
			return true
		if event.button_index == MOUSE_BUTTON_RIGHT:
			press("ka", song_t)
			return true
	return false


# ================================================================== drawing
func _draw() -> void:
	hit_regions.clear()
	if phase in ["play", "result"]:
		_draw_dance()
		return
	var goals := [
		{"t": "打听", "d": "问清卖瓷片的少年在哪", "done": asked.has("barkeep") and asked.has("stairs") and asked.has("drum")},
		{"t": "胡旋", "d": "为米娜击鼓伴舞", "done": phase == "done"},
		{"t": "阿拾", "d": "见到捡碎瓷的少年", "done": phase == "done"},
	]
	var obj := "在酒肆里打听那个卖瓷片的少年。"
	if goals[0]["done"] and phase == "explore":
		obj = "问齐了。点击米娜。"
	elif phase == "ready":
		obj = "准备击鼓。"
	elif phase == "done":
		obj = "阿拾答应带路。今夜穿城。"
	_frame("第三章  ·  胡旋", "西市 · 胡姬酒肆  /  闭市后 · 灯下", goals, obj, [])
	if not _img_cover("tavern", ROOM):
		draw_rect(bleed(), Color("2a1c18"))
	draw_rect(bleed(), Color(0.02, 0.02, 0.03, 0.1))
	var talking: bool = g.dlg.active and g.dlg.entry().get("w", "") == "mi"
	if not talking:
		_figure("npc_mi", MI_FOOT, 400)
	if phase == "done":
		_next_button("to_map", "回长安舆图  ›")
	if g.blocked():
		return
	for id in SPOTS:
		_hotspot(id, SPOTS[id]["p"], SPOTS[id]["label"], SPOTS[id]["r"], asked.has(id))
	if phase == "explore":
		_hotspot("mi", MI_FOOT + Vector2(0, -420), "米娜" + ("  · 请她叫人" if goals[0]["done"] else ""), Rect2(MI_FOOT + Vector2(-80, -400), Vector2(160, 400)))
	if phase == "ready":
		_hud(_draw_ready_card)


func _draw_ready_card() -> void:
	_modal_back(0.6)
	var card := Rect2(420, 330, 600, 260)
	_panel(card)
	_tc(card.get_center().x, card.position.y + 52, "胡旋 · 羯鼓", 28, Pal.PAPER)
	_tc(card.get_center().x, card.position.y + 88, "散序 → 中序 → 入破  ·  约 80 秒", 14, Pal.MUTED)
	_tc(card.get_center().x, card.position.y + 120, "咚 F / J / 左键      嗒 D / K / 右键      连打：狂敲任意键", 14, Pal.SOFT)
	_button("start", Rect2(card.position.x + 50, card.position.y + 160, 240, 50), "开始击鼓", true, 18)
	_button("start_easy", Rect2(card.position.x + 310, card.position.y + 160, 240, 50), "简单模式", false, 16)


func _x_for(t_note: float) -> float:
	return HIT_X + (t_note - song_t) / LEAD * (LANE.end.x - HIT_X - 40)


func _live_acc() -> float:
	var judged: float = counts["great"] + counts["good"] + counts["miss"]
	if judged == 0:
		return 1.0
	return (counts["great"] + counts["good"] * 0.5) / judged


func _draw_dance() -> void:
	if not _img_cover("tavern", Rect2(0, 0, 1440, 900), Color(0.45, 0.4, 0.42)):
		draw_rect(Rect2(0, 0, 1440, 900), Color("1d1416"))
	draw_rect(Rect2(0, 0, 1440, 900), Color(0.03, 0.02, 0.03, 0.35))
	var cc := Vector2(720, 470)
	for r in range(8, 0, -1):
		draw_circle(cc, 120 + r * 26, Color(1, 0.75, 0.4, 0.018))
	draw_set_transform(cc, 0.0, Vector2(1, 0.32))
	draw_circle(Vector2.ZERO, 230, Color("7a2a22"))
	draw_arc(Vector2.ZERO, 215, 0, TAU, 64, Color("d7b77b"), 4)
	draw_arc(Vector2.ZERO, 160, 0, TAU, 64, Color(0.84, 0.72, 0.48, 0.5), 2)
	draw_set_transform(Vector2.ZERO)
	_draw_dancer(cc + Vector2(0, 10))
	var s := section_at(maxf(song_t, 0.0))
	for i in range(Chart.SECTIONS.size()):
		var c := Pal.GOLD if i == s else (Pal.JADE if i < s else Color("51605a"))
		_box(Rect2(70 + i * 140, 40, 128, 40), Color(0.05, 0.07, 0.08, 0.85), 6, c)
		_tc(134 + i * 140, 67, Chart.SECTIONS[i]["name"], 18, c)
	_t(Vector2(70, 110), "%s  ·  %d BPM" % ["简单模式" if easy else "普通", int(Chart.SECTIONS[s]["bpm"])], 13, Pal.MUTED)
	_t(Vector2(1150, 66), "%07d" % score, 26, Pal.PAPER)
	_t(Vector2(1150, 96), "准确率 %d%%" % int(round(_live_acc() * 100)), 14, Pal.GOLD)
	if combo >= 3:
		_tc(1080, 330, "%d" % combo, 54, Color(1, 0.86, 0.5, 0.9))
		_tc(1080, 358, "连击", 14, Pal.GOLD)
	if section_banner > 0 and song_t >= 0.0:
		_tc(720, 150, str(Chart.SECTIONS[s]["name"]), 40, Color(1, 0.94, 0.8, minf(1.0, section_banner)))
	var prog := clampf(song_t / Chart.END, 0.0, 1.0)
	draw_rect(Rect2(70, 870, 1300, 4), Color(0.2, 0.2, 0.2, 0.7))
	draw_rect(Rect2(70, 870, 1300 * prog, 4), Pal.GOLD)
	_draw_lane()
	if judge_t > 0:
		var k := judge_t / 0.5
		_tc(HIT_X, LANE.position.y - 22 - (1.0 - k) * 16, judge_text, 30, Color(judge_col, k))
	if song_t < 0.0 and phase == "play":
		_tc(720, 380, str(int(ceil(-song_t))), 64, Pal.PAPER)
	if phase == "result":
		_draw_result()


func _draw_lane() -> void:
	_box(LANE, Color(0.04, 0.05, 0.06, 0.88), 10, Color(0.84, 0.72, 0.48, 0.6))
	var y := LANE.get_center().y
	var c := Vector2(HIT_X, y)
	# The drum: the head lights for 咚, the rim for 嗒.
	draw_circle(c, 46, Color("3b2a20"))
	draw_circle(c, 40, Color(0.9, 0.55, 0.35, 0.35 + drum_flash["don"] * 4.0))
	draw_arc(c, 46, 0, TAU, 40, Color(0.55, 0.8, 1.0, 0.5 + drum_flash["ka"] * 4.0), 5, true)
	draw_arc(c, 52, 0, TAU, 40, Pal.GOLD, 2, true)
	for i in range(notes.size() - 1, -1, -1):
		var n: Dictionary = notes[i]
		var t0 := float(n["t"])
		if t0 - song_t > LEAD + 0.2:
			continue
		if n["k"] == "roll":
			var x0 := maxf(_x_for(t0), HIT_X)
			var x1 := minf(_x_for(t0 + float(n["d"])), LANE.end.x - 60)
			if x1 < HIT_X - 10 or n["done"]:
				continue
			_box(Rect2(x0 - 30, y - 26, maxf(x1 - x0, 0) + 60, 52), Color(1, 0.8, 0.3, 0.75), 26, Color("ffe7a0"), 2)
			_t(Vector2(x0 - 14, y + 8), "连打", 18, Pal.INK)
			continue
		if n["done"] and n["res"] != "miss":
			continue
		var x := _x_for(t0)
		if x < LANE.position.x - 20 or x > LANE.end.x - 30:
			continue
		var don: bool = n["k"] == "don"
		var col := Color("e0533e") if don else Color("3f8fd6")
		var r := 30.0 if don else 26.0
		if n["done"]:
			col = Color(0.3, 0.3, 0.3, 0.6)
		draw_circle(Vector2(x, y), r + 4, Color("f3e3c0"))
		draw_circle(Vector2(x, y), r, col)
		_tc(x, y + 8, "咚" if don else "嗒", 20, Color.WHITE)
	_t(Vector2(LANE.position.x + 12, LANE.end.y + 26), "咚  F / J / 左键", 14, Color("ff9a86"))
	_t(Vector2(LANE.position.x + 180, LANE.end.y + 26), "嗒  D / K / 右键", 14, Color("8fc4ff"))
	_t(Vector2(LANE.position.x + 350, LANE.end.y + 26), "连打  狂敲任意键", 14, Color("ffd27a"))
	_t(Vector2(LANE.end.x - 150, LANE.end.y + 26), "Esc 放弃", 14, Pal.MUTED)


## The dancer: AI portrait scaled on X to fake a spin, plus silk ribbon trails.
func _draw_dancer(foot: Vector2) -> void:
	var sway := sin(spin) * 0.08
	var squash := 0.55 + 0.45 * absf(cos(spin))
	var flip := 1.0 if cos(spin) >= 0 else -1.0
	for i in range(sleeves.size() - 1):
		var a: Vector3 = sleeves[i]
		var b: Vector3 = sleeves[i + 1]
		var k := 1.0 - float(i) / sleeves.size()
		var pa := foot + Vector2(a.x * 150, -230 + a.y * 40)
		var pb := foot + Vector2(b.x * 150, -230 + b.y * 40)
		draw_line(pa, pb, Color(1, 0.85, 0.45, 0.55 * k), 6 * k + 1, true)
		draw_line(pa + Vector2(0, 90), pb + Vector2(0, 90), Color(0.85, 0.25, 0.2, 0.4 * k), 5 * k + 1, true)
	draw_set_transform(foot, sway, Vector2(squash * flip, 1))
	if g.tex.has("npc_mi"):
		var t: Texture2D = g.tex["npc_mi"]
		var h := 380.0
		var w := t.get_size().x / t.get_size().y * h
		draw_texture_rect(t, Rect2(-w * 0.5, -h, w, h), false)
	else:
		draw_colored_polygon(PackedVector2Array([Vector2(0, -360), Vector2(-90, 0), Vector2(90, 0)]), Color("a8322a"))
	draw_set_transform(Vector2.ZERO)
	var flare := clampf(spin_speed / 20.0, 0.0, 1.0)
	if flare > 0.1:
		draw_set_transform(foot + Vector2(0, -60), 0.0, Vector2(1, 0.25))
		draw_arc(Vector2.ZERO, 70 + flare * 60, spin * 2.0, spin * 2.0 + PI * 1.2, 24, Color(1, 0.55, 0.35, 0.5 * flare), 8, true)
		draw_set_transform(Vector2.ZERO)


func _draw_result() -> void:
	draw_rect(Rect2(0, 0, 1440, 900), Color(0, 0, 0, 0.5))
	var card := Rect2(440, 250, 560, 380)
	_panel(card)
	var ok: bool = result.get("pass", false)
	_tc(720, 310, "满堂喝彩！" if ok else "鼓点乱了……", 32, Pal.PAPER if ok else Color("ffb0a0"))
	_tc(720, 360, "准确率  %d%%   （需要 %d%%）" % [int(round(result.get("acc", 0.0) * 100)), int(result.get("need", PASS) * 100)], 18, Pal.GOLD)
	_tc(720, 398, "良 %d   可 %d   不可 %d   连打 %d" % [counts["great"], counts["good"], counts["miss"], roll_hits], 16, Pal.SOFT)
