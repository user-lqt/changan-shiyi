	],
	"ch5_arrive": [
		{"w": "narr", "t": "当日午后，曲江池畔。新科进士在水边设宴，席间行诗令：一人出韵，众人接句，得分少者罚酒。"},
		{"w": "su", "t": "值夜师父已答应留住碎片。今天来这里，是想请一位赴慈恩寺题名的进士替我们引见，向知客僧说明取物的来意。"},
		{"w": "ashi", "t": "姐姐，那位穿绿袍的就是今年及第的白先生。宴后进士们要去慈恩寺塔下题名。"},
		{"w": "bai", "t": "在下白居易。二位要进慈恩寺？今日席上行诗令，你若能连过三巡，我题名时便替你们向寺僧引见。"},
		{"w": "zheng", "t": "白乐天又发善心了。一个女子、一个小乞儿，也配上进士的席？"},
		{"w": "bai", "t": "郑兄，诗席论诗，不论门第。——苏娘子，请。"},
		{"w": "su", "t": "（平仄、押韵……博物馆的诗词展我讲解过好几回，这次要真的上场了。）"},
		{"w": "narr", "t": "【诗牌】每句由 2–3 张词牌加 1 张韵脚组成（五言或七言）。得分 = 墨 × 韵。合律、押韵、对仗都能大幅加韵。"},
		{"w": "narr", "t": "牌上 ○ 是平声，● 是仄声。第二、四、六字平仄要交替，句尾不能连三平或三仄。卡住了可以按「荐句」。"},
	],
	"ch5_done": [
		{"w": "narr", "t": "第三巡最后一句落下，满座静了一瞬，随即有人击案叫好。"},
		{"w": "zheng", "t": "……罢了。今日这杯，我认罚。"},
		{"w": "bai", "t": "「诗者，根情，苗言，华声，实义。」娘子的句子，声律之外，还有真意。"},
		{"w": "su", "t": "先生过奖。我们要找一片落在大雁塔上的青瓷，可否请先生替我们向寺僧说明来意？"},
		{"w": "bai", "t": "一言为定。我正要去塔下题名，你们随我同行；能否登塔，仍要听寺里安排。"},
		{"w": "ashi", "t": "这回总算能从正门进去了。姐姐，走！"},
		{"w": "narr", "t": "日影渐斜，进士们收起诗笺，动身前往慈恩寺。苏晴与阿拾随白居易同行，抵达时，暮色已落在塔檐上。"},
	],
	"ch6_enter": [
		{"w": "narr", "t": "暮色中的慈恩寺。白居易替两人引见知客僧，核明失物来历后，塔门终于打开。"},
		{"w": "narr", "t": "知客僧将一盏灯交给苏晴。"},
		{"w": "seng", "t": "前夜落在塔顶的东西未曾挪动。沿阶上去便是，若遇异状，莫要勉强。"},
		{"w": "ashi", "t": "姐姐，我认得城里的路，却没登过这么高的塔。这回……我跟着你。"},
		{"w": "su", "t": "好，慢慢走。找到最后一片，我们就能把温师傅的碗补好了。"},
	],
	"ch6_lights": [
		{"w": "narr", "t": "第二层。窗外，长安的灯火沿街巷铺开。酒肆的鼓声已听不清，只剩檐铃和两人的脚步。"},
		{"w": "ashi", "t": "那边是西市。再往西，就是温师傅的镜坊。原来站高一点，走过的路都能看见。"},
		{"w": "su", "t": "我刚来时只想着赶快回家。现在回头看……这一路，已经认识了好些人。"},
	],
	"ch6_trace": [
		{"w": "narr", "t": "第三层。旧铜镜前忽然凝起一面残镜，冷白的光沿镜缘掠过，一道，又一道，与手中灯火截然不同。"},
		{"w": "su", "t": "这光带……和实验室里的结构光很像。为什么会留在塔里？"},
		{"w": "ashi", "t": "镜里刚才是不是有人？……转眼又没了。"},
		{"w": "su", "t": "先别碰。它往楼梯那边去了——跟着光痕往上看看。"},
	],
	"ch6_echo": [
		{"w": "narr", "t": "第四层。镜面忽然变亮，油灯的倒影里，浮出一张苏晴熟悉的工作台。"},
		{"w": "su", "t": "扫描仪、转台……那是我离开前的实验室！"},
		{"w": "narr", "t": "铜镜发光、碗沿崩裂、碎瓷飞散。断续的影像如水纹般重叠，又向塔顶聚去。"},
	],
	"ch6_phantom": [
		{"w": "narr", "t": "第五层。楼梯转角传来低语，一面残破铜镜悬在半空，散开的镜片围着幽光缓缓游动。"},
		{"w": "boss", "t": "……别动那片瓷。"},
		{"w": "su", "t": "前夜的白光里，是你？"},
		{"w": "boss", "t": "你把光带来了……为什么，又要拿走……"},
		{"w": "ashi", "t": "姐姐，她好像……在害怕。"},
		{"w": "su", "t": "我还不知道发生了什么。我想取回碎片，也想听你把话说清楚。"},
		{"w": "narr", "t": "残镜微微倾转，围着它的碎片骤然收拢，向上层飞去。苏晴握稳了灯，循着留下的光痕继续上行。"},
	],
	"ch6_bells": [
		{"w": "narr", "t": "第六层。三只铜铃轻轻震动。墙上的月相由暗至明，依次映出朔、弦、望。"},
		{"w": "ashi", "t": "没有月亮、半个月亮、圆月亮……铃声也是照着这个顺序来的。"},
		{"w": "su", "t": "朔、弦、望。先记下来；上面的镜光，也许遵循同样的次序。"},
		{"w": "narr", "t": "【手札已记录】月相三铃：朔 → 弦 → 望。"},
	],
	"ch6_summit": [
		{"w": "narr", "t": "第七层。月光落在三环铜盘上，莲纹青瓷嵌在中央。最后一片，终于近在眼前。"},
		{"w": "ashi", "t": "是这里……那晚白光就落在这里。"},
		{"w": "su", "t": "阿拾，先站在我身后。镜中的声音，还没有把话说完。"},
		{"w": "narr", "t": "苏晴向铜盘走近一步。塔壁上的碎光同时抬起，围着残镜凝成八瓣光轮。镜面深处，裂纹如水流般明灭。"},
	],
	"ch7_arrive": [
		{"w": "narr", "t": "白居易替两人引见了寺僧，说明寻瓷的来意。得寺里允准，苏晴与阿拾沿塔阶而上；登临顶层时，月亮已升上檐角。", "if": "bai_introduction", "ifnot": "tower_ascent_done"},
		{"w": "narr", "t": "大慈恩寺，大雁塔顶层。月光从拱窗倾泻进来，照着一座三环铜盘。", "ifnot": "tower_ascent_done"},
		{"w": "ashi", "t": "就是这里！那晚白光最后落下的地方。姐姐，你看铜盘中间。", "ifnot": "tower_ascent_done"},
		{"w": "su", "t": "铜盘中央嵌着什么在发光……是最后一片！", "ifnot": "tower_ascent_done"},
		{"w": "narr", "t": "铜盘上的光越来越亮。残镜围住青瓷，镜中的声音等待苏晴走近。", "if": "tower_ascent_done"},
	],
	"boss_prelude": [
		{"w": "narr", "t": "苏晴伸手去取碎片——铜环骤然转动，镜光托起青瓷，从拱窗飞向塔刹。檐下的纸鹤、廊间的长明灯，都被这道光惊醒了。"},
		{"w": "su", "t": "碎片被光卷到塔刹上去了！阿拾，躲在铜盘后面，我去追。"},
		{"w": "narr", "t": "【月下镜阵】方向键 / WASD 移动，按住 Shift 凝神慢行并显示判定点，按住 Z 发射镜芒，X 释放护身月华、驱散流光。Esc 暂停。"},
	],
	"boss_intro": [
		{"w": "boss", "t": "……光。是你带来的光。"},
		{"w": "boss", "t": "我是被那道光惊醒的镜魅。千年的月华都在我身上，谁也别想拿走。"},
		{"w": "su", "t": "阿拾在白光里看见的人影，方才塔里低语的声音……都是你。是我的扫描光惊醒了你，也把我带到了这里。"},
		{"w": "su", "t": "对不起。我只想取回那片青瓷，把温师傅的碗修好，再寻找回家的路。"},
		{"w": "boss", "t": "那片瓷上留着唤醒我的镜光。你取走它，我便再也凝不住这些月华。"},
		{"w": "boss", "t": "那就——让月光来裁决吧！"},
	],
	"boss_form2": [
		{"w": "narr", "t": "铜镜从中裂开。碎片没有落地，而是绕着镜魅飞旋起来。"},
		{"w": "boss", "t": "镜子碎了……可碎镜里，能照出更多的月亮。"},
		{"w": "su", "t": "她的气息变了。最后一阵，撑过去！"},
	],
	"boss_defeat": [
		{"w": "su", "t": "我会带走碎片，修好那只碗。可月亮还在，长安也还在——你不必把每一束光都困在这里。"},
		{"w": "boss", "t": "……这月光，本就该照向回家的路。"},
		{"w": "boss", "t": "去吧。替我看看千年以后的月亮。"},
		{"w": "narr", "t": "镜魅化作点点光尘。月华散尽，最后一片碎瓷轻轻落回苏晴掌心。"},
	],
	"finale_intro": [
		{"w": "narr", "t": "离塔时夜禁已起，两人依寺僧安排暂宿寺中。翌日晨鼓一响，他们便带着最后一片青瓷，沿开放的街巷返回镜坊。"},
		{"w": "narr", "t": "温师傅接过残片，逐一核对：镜坊两片、西市一片、塔顶一片，四处缺口终于都有了归处。"},
		{"w": "wen", "pose": "explain", "t": "四片都在这儿了。来，老朽眼花，碎片由你来拼。"},
		{"w": "narr", "t": "【拼合修复】拖动碎片到碗上的缺口，用滚轮或 Q / E 旋转。角度对了才能嵌进去。"},
	],
	"finale_done": [
		{"w": "wen", "pose": "explain", "t": "好！再以生漆粘合，金粉描缝——这叫金缮。"},
		{"w": "wen", "pose": "recall", "t": "碎过的地方，反倒成了最好看的纹。器物如此，人也如此。"},
		{"w": "wen", "pose": "recall", "t": "回去吧，千年以后的姑娘。替老朽看看那时的长安。", "if": "told_truth"},
		{"w": "wen", "pose": "recall", "t": "旅人，你的路在镜子那头吧？去吧，别回头。", "ifnot": "told_truth"},
		{"w": "narr", "t": "铜镜再次亮起。白光过后，是实验室熟悉的嗡鸣。"},
	],
	"epilogue_wake": [
		{"w": "narr", "t": "嗡鸣声由远及近。苏晴扶着操作台站稳，扫描室的冷光、转台、屏幕……一切都在原处。"},
		{"w": "su", "t": "（墙上的钟是一点零七分。在长安过了三天，这里才过去七分钟？）"},
		{"w": "su", "t": "先别慌。看看扫描数据，再看看那两件器物。"},
		{"w": "narr", "t": "【实验室】点击画面进入第一人称；WASD 行走，鼠标环顾，靠近并对准物品按 E 查看。Tab 自动走向下一处。"},
	],
	"epilogue_screen": [
		{"w": "narr", "t": "屏幕上，莲纹碗的三维模型正在缓缓旋转。四处缺口都已闭合，取而代之的是几道细细的金线。"},
		{"w": "su", "t": "采集时间，一点零七分。四处缺口都有了数据……可我没有补过这些面。"},
		{"w": "su", "t": "先核对实物。如果金缝也在那只碗上，这就不只是电脑里的变化。"},
	],
	"epilogue_bowl": [
		{"w": "narr", "t": "展柜里，那只越窑莲纹碗静静立着。四道金缝，正好落在碗沿、碗腹和莲纹中心。"},
		{"w": "su", "t": "碗沿两片，碗腹一片，莲心一片……每一道金缝，都是我在长安亲手找回的那片。"},
		{"w": "su", "t": "温师傅用生漆和金粉补的。漆色这样旧，是过了一千多年的样子。"},
		{"w": "su", "t": "我离开时，它明明还缺着。现在，温师傅补过的痕迹，真的留到了这里。"},
		{"w": "su", "t": "不能把这些缝当成瑕疵抹掉。它们也是这只碗的经历。"},
	],
	"epilogue_mirror": [
		{"w": "narr", "t": "转台上的海兽葡萄纹铜镜已经暗了下来。苏晴把手放在镜背上，铜面还留着一点温度。"},
		{"w": "su", "t": "镜魅……你还在里面吗？"},
	],
	"epilogue_memory": [
		{"w": "su", "t": "温师傅、康掌柜、米娜、阿拾、白先生……还有她。"},
		{"w": "su", "t": "不是梦。我真的去过长安。"},
		{"w": "narr", "t": "最后一缕镜光落下。镜面里只剩苏晴自己的倒影，窗外传来远处的车声。"},
	],
	"epilogue_mirror_again": [
		{"w": "narr", "t": "铜镜安静地停在转台上，葡萄枝蔓间留着一线淡淡的月色。"},
		{"w": "su", "t": "嗯。我记住了，替你看看以后的月亮。"},
	],
	"epilogue_memory_ready": [
		{"w": "su", "t": "屏幕和实物都核对过了。最后，去窗边看看吧。"},
	],
	"epilogue_memory_remaining": [
		{"w": "su", "t": "先把剩下的器物和数据核对完，再去窗边。"},
	],
	"epilogue_window": [
		{"w": "narr", "t": "窗外是夜里的西安。远处，大雁塔亮着灯，一轮满月正挂在塔刹上方。"},
		{"w": "su", "t": "她说，替她看看千年以后的月亮。"},
		{"w": "su", "t": "月亮还在。长安也还在。"},
		{"w": "su", "t": "原来修复不只是把碎片还原，也是把一段故事接上。"},
		{"w": "narr", "t": "她回头看了一眼操作台，又望向窗外。千年前的灯火已经远去，这座城却仍在月下延续。"},
		{"w": "narr", "t": "《长安拾遗》 · 完"},
	],
	"epilogue_coin": [
		{"w": "su", "t": "口袋里……是温师傅让我留着的那枚开元通宝。"},
		{"w": "su", "t": "连边上那道小磕痕都一样……真的带回来了。先把发现的经过好好记下来。"},
	],
}

## Artifact / lore cards. tex = texture key (optional).
const CARDS := {
	"qujiang": {"tag": "曲江见闻  /  CHAPTER 05", "title": "曲江宴与雁塔题名", "tex": "feast",
		"text": "唐代进士放榜后，新科进士在曲江池畔宴集，又到慈恩寺塔下题名留念。曲江是长安城东南的游赏胜地，春日游人最盛。",
		"more": "白居易贞元十六年（800 年）进士及第，后来有诗句「慈恩塔下题名处，十七人中最少年」。本章的诗令、郑公子与主角的相遇是游戏虚构。"},
	"pingze": {"tag": "诗律  /  RULES", "title": "平仄与押韵", "tex": "",
		"text": "唐人把字调分为平、上、去、入四声，平声为「平」，其余为「仄」。近体诗讲究平仄交替（「二四六分明」），偶数句押平声韵。",
		"more": "「月」「白」「曲」「落」等是古入声字，属仄声，今天普通话多读成平声。游戏的平仄标注依唐音。"},
	"mirror": {"tag": "藏品图鉴  /  ARTIFACT", "title": "海兽葡萄纹铜镜", "tex": "mirror",
		"text": "唐代铜镜的代表样式。镜背以瑞兽穿行于葡萄枝蔓间，融合了丝绸之路传来的西域纹样，是盛唐长安开放气象的缩影。",
		"more": "镜面经研磨可清晰映物。古人亦用铜镜反射日光、灯光——这正是本章机关的灵感来源。"},
	"shard": {"tag": "碎片  1 / 4", "title": "越窑青瓷 · 碗沿残片", "tex": "shard",
		"text": "越窑青瓷釉色如玉，陆羽《茶经》称其「类玉」「类冰」，列为茶碗第一。",
		"more": "断口与残碗左沿的缺口吻合，细细的莲瓣纹仍能接续。"},
	"shard_b": {"tag": "碎片  2 / 4", "title": "越窑青瓷 · 右沿残片", "tex": "shard",
		"text": "右侧碗沿留着半朵莲瓣。唐代越窑常以刻花、划花装饰，刀法流畅，线条深浅有致。",
		"more": "莲纹寓意清净，在唐代器物中十分常见。"},
	"shard_c": {"tag": "碎片  3 / 4", "title": "越窑青瓷 · 碗腹残片", "tex": "shard",
		"text": "从康掌柜手里讨回的一片。长安的商旅往来连接中原与西域，粟特人在中古贸易与文化交流中发挥了重要作用。",
		"more": "「胡商」并非单一民族名称，不能只凭康姓判断一个人的祖籍与身份。"},
	"shard_d": {"tag": "碎片  4 / 4", "title": "越窑青瓷 · 莲心残片", "tex": "shard",
		"text": "碗心的莲纹。大雁塔建于唐高宗永徽三年（652 年），用以保存玄奘从天竺带回的经像。",
		"more": "四片已全部寻回。回镜坊，把碗补起来吧。"},
	"bowl": {"tag": "藏品图鉴  /  RESTORED", "title": "越窑青瓷刻莲纹碗", "tex": "bowl",
		"text": "四片碎瓷重新拼合，金线沿裂痕展开。这是游戏对修复的艺术化表现，象征器物与人的经历被一同保留下来。",
		"more": "描金接缝不等于已证实的唐代修复工艺。现实文物修复需评估材质、病害与证据，记录干预，区分原物与补配。"},
	"ledger": {"tag": "获得物证", "title": "账簿", "tex": "",
		"text": "翻到昨日的最后一笔，墨迹还新：\n「戌初，收旧瓷残片一，钱二百文。」",
		"more": "唐代商铺已有记账习惯，敦煌文书中保存了不少这类账目。"},
	"bundle": {"tag": "获得物证", "title": "锦缎包袱", "tex": "",
